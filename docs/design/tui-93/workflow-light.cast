[50.6058, "o", "\u001b]2;AgentSession\u0007\u001b[H\u001b[2J\u001b[38;2;8;127;140;1mAgentSession  /  Timeline  \u00b7  local \u00b7 offline \u00b7 read-only\u001b[m\u001b[K\r\n\u001b[38;2;37;50;74;1mTimeline \u00b7 session fixture-17 \u00b7 canonical complete\u001b[m\u001b[K\r\n\u001b[38;2;37;50;74;48;2;221;243;241;1m> \u256d\u2500 You\u001b[K\u001b[m\r\nFix request timeout without hiding errors.\u001b[K\r\n\u2570\u2500\u001b[K\r\n\u001b[K\n\u001b[38;2;36;87;166;1m  \u256d\u2500 Assistant\u001b[K\u001b[m\r\n\u001b[38;2;37;50;74;1m\u00a7 Retry policy\u001b[K\u001b[m\r\n\u001b[K\n- Bound each retry.\u001b[K\r\n- Keep the original cause.\u001b[K\r\n\u001b[K\n\u001b[38;2;37;50;74;1mCode \u00b7 go\u001b[K\u001b[m\r\nfunc retry(ctx context.Context) error {\u001b[K\r\n    return request.WithTimeout(ctx, \"https://example.invalid/api/very/long/pat\u001b[K\r\n    h/for/terminal/wrapping\", 3*time.Second)\u001b[K\r\n}\u001b[K\r\n\u001b[K\n\u001b[K\n\u001b[38;2;37;50;74;1m\u00a7 Reading notes\u001b[K\u001b[m\r\n\u001b[K\n1. Recorded evidence remains in source order; a build does not establish test\u001b[K\r\nTarget: evt_cdcc2c120140d\u2026 #0 \u00b7 open \u00b7 Index: complete\u001b[K\r\n\u001b[38;2;102;112;133m\u2191\u2193 scroll \u00b7 [/] events \u00b7 Enter toggle \u00b7 d inspect \u00b7 Esc back \u00b7 ? help\u001b[m\u001b[K"]
