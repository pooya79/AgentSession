[49.3983, "o", "\r\u001b[3d\u001b[38;2;37;50;74;48;2;221;243;241;1m> You\u001b[K\u001b[m\r\nFix request timeout without hiding errors.\r\n\u001b[K\n\u001b[38;2;36;87;166;1m  Assistant\u001b[K\u001b[m\r\n\u001b[38;2;37;50;74;1m\u00a7 Retry policy\u001b[K\u001b[m\r\n\u001b[K\n- Bound each retry.\u001b[K\r\n- Keep the original cause.\u001b[K\r\n\u001b[K\n\u001b[38;2;37;50;74;1mCode \u00b7 go\u001b[K\u001b[m\r\nfunc retry(ctx context.Context) error {\u001b[K\n\u001b[5Greturn request.WithTimeout(ctx, \"https://example.invalid/api/very/long/pat\r\n    h/for/terminal/wrapping\", 3*time.Second)\u001b[K\r\n}\r\n\u001b[K\n\n\u001b[38;2;37;50;74;1m\u00a7 Reading notes\u001b[K\u001b[m\r\n\u001b[K\n1. Recorded evidence remains in source order; a build does not establish test\r\n   recovery.\u001b[K\n\b\b\b0 \u00b7 open\u001b[K\r\n\u001b[38;2;102;112;133m\u2191\u2193 read \u00b7 [] events \u001b[m\u001b[5P"]
