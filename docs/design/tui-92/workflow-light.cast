[4.6041, "o", "\u001b[1;41H\u001b[38;2;8;127;140;1mfline \u00b7 read-only\u001b[m\r\n\u001b[38;2;37;50;74;1mKeyboard help\u001b[K\u001b[m\r\n\nGlobal\u001b[K\r\n  ?            open or close this help\u001b[K\r\n  Esc          close an overlay or return to the parent screen\r\n  q / Ctrl-C   quit\u001b[K\r\n\nNavigation\u001b[K\r\n  \u2191/\u2193 or j/k   scroll timeline text; move rows in lists\r\n  [ / ]        jump to previous/next timeline event\r\n  Home/End     jump to the first or last row\u001b[K\r\n  g/G          jump to the first or last row\u001b[K\r\n  PgUp/PgDn    scroll long evidence\u001b[K\r\n  n/p          next/previous session or search page\r\n  Enter        open a session or expand/collapse a timeline card\u001b[K\r\n  Target       footer names the event Enter, d and u act on\u001b[K\r\n  Esc          return to the previous reading context, including search\u001b[K\r\n\u001b[K\nActions\u001b[K\r\n  d            inspect selected normalized event\u001b[K\r\n  w            toggle wrapping in inspection; \u2190/\u2192 pan when unwrapped\u001b[23;9H\u001b[38;2;37;50;74;1mHelp \u00b7 returns to Indexing\u001b[m\n\u001b[C\u001b[38;2;102;112;133mEsc close \u00b7 ? close\u001b[m\u001b[K"]
[5.2005, "i", "G"]
[5.2542, "o", "\u001b[H\n  f            inspect rule assessments from the timeline\u001b[K\r\n  [ / ]        select assessment evidence; Enter opens timeline context\r\n  i            inspect indexing details from sessions\r\n  /            open search or edit the current search query\r\n\u001b[K\nSearch editing\u001b[K\r\n  \u2190/\u2192          move the query cursor\r\n  Home/End     beginning/end of query (also Ctrl-A/Ctrl-E)\r\n  Backspace/Del delete before/at the cursor\u001b[K\r\n  Paste        insert query text, including shortcut characters\r\n  Enter        submit query; Esc stops editing, then returns\r\n  r            retry search; edited queries require a new search\r\n  Filters      session: kind: after: before: file: tool: command:\r\n  Shortcuts such as q / ? [ ] remain text while editing.\r\n\u001b[K\nEvidence actions\u001b[K\r\n  x            inspect projection lifecycle from a timeline\u001b[K\r\n  u            inspect redacted retained evidence for an Unknown event\r\n\u001b[38;2;180;35;24;1m  t            retry implemented pending or failed projections\u001b[K\u001b[m\r\n  b            rebuild the focused projection when implemented\r\n  a            rebuild all only when every projection is implement"]
[5.857, "i", "\u001b"]
