[2.2191, "o", "\r\u001b[3d\u001b[1m> \u256d\u2500 You\u001b[K\u001b[m\r\nFix request timeout without hiding errors.\r\n\u2570\u2500\r\n\n\u001b[1m  \u256d\u2500 Assistant\u001b[K\u001b[m\r\n\u001b[1m\u00a7 Retry policy\u001b[K\u001b[m\r\n\n- Bound each retry.\r\n- Keep the original cause.\r\n\n\u001b[1mCode \u00b7 go\u001b[K\u001b[m\r\nfunc retry(ctx context.Context) error {\n\u001b[5Greturn request.WithTimeout(ctx, \"https://example.invalid/api/very/long/pat\n\u001b[5Gh/for/terminal/wrapping\", 3*time.Second)\r\n}\r\n\n\n\u001b[1m\u00a7 Reading notes\u001b[K\u001b[m\r\n\n1. Recorded evidence remains in source order; a build does not establish test\r\nTarget: evt_cdcc2c120140d\u2026 #0 \u00b7 open \u00b7 Index: complete"]
