package web

import (
	"github.com/pooya79/AgentSession/internal/app"
	"github.com/pooya79/AgentSession/internal/model"
)

// Message and summary cards preserve normalized text as escaped, preformatted
// evidence rather than interpreting it as markup.
templ messageCard(message model.MessageData) {
	<section class={ "message-card message-" + string(message.Role) }>
		<h3>{ messageRoleLabel(message.Role) }</h3>
		<div class="message-text">{ message.Text }</div>
	</section>
}

templ summaryCard(summary model.SummaryData) {
	<details class={ "activity-card summary-card summary-" + string(summary.Category) }>
		<summary>
			<span class="activity-title">{ app.SummaryCategoryTitle(summary.Category) }</span>
			<span class="summary-preview">{ summary.Text }</span>
		</summary>
		<div class="expanded-content">
			<h3>{ app.SummaryCategoryTitle(summary.Category) }</h3>
			<pre>{ summary.Text }</pre>
		</div>
	</details>
}
