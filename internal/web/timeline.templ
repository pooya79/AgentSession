package web

import (
	"github.com/pooya79/AgentSession/internal/app"
	"github.com/pooya79/AgentSession/internal/model"
)

// timelinePage renders a bounded page of canonical events with normalized
// payloads inline. Retained raw records remain behind the explicit Unknown
// evidence action.
templ timelinePage(view timelineView) {
	@document("Timeline · AgentSession") {
		<main id="main">
			<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Sessions</a><span aria-hidden="true">/</span><span aria-current="page">Timeline</span></nav>
			<header class="page-heading">
				<div>
					<p class="eyebrow">Canonical timeline</p>
					<h1 class="session-id">{ string(view.SessionID) }</h1>
					<p class="muted">Normalized conversation and activity evidence, loaded in bounded batches.</p>
				</div>
			</header>
			@notice(view.Notice)
			<section class="projection-panel" aria-labelledby="projection-title">
				<div class="section-heading">
					<div><p class="eyebrow">Secondary derived data</p><h2 id="projection-title">Projection readiness</h2></div>
				</div>
				if view.ProjectionErr != nil {
					<p class="notice warning" role="status">Projection status is unavailable. Canonical evidence below is unaffected.</p>
				} else {
					<div id="projection-status">
						@projectionStatus(view.Projection, view.CSRF, "")
					</div>
				}
			</section>
			<section aria-labelledby="events-title">
				<h2 id="events-title">Conversation and activity</h2>
				@timelineEvidenceState(view.Page, view.DiagnosticRefs)
				<div class="timeline">
					@eventRows(view.SessionID, view.Page, view.DiagnosticRefs, view.CSRF)
				</div>
			</section>
		</main>
	}
}

templ timelineEvidenceState(page app.TimelinePage, refs map[model.EventID]eventReference) {
	if page.State == app.EvidenceUnavailable {
		<p class="notice warning">Normalized timeline evidence is unavailable. This is not evidence of success.</p>
	} else if page.State == app.EvidencePartial {
		<p class="notice warning">This timeline contains partial evidence. Review diagnostics before drawing conclusions.</p>
	}
	<p class="metadata">Interpretation: { string(page.Interpretation.State) } · { strconvFormatInt(page.Interpretation.UnknownEvents) } Unknown events · { strconvFormatInt(page.Interpretation.MalformedRecords) } malformed records</p>
	@diagnosticSynopsis(page.Diagnostics, refs)
}

// eventRows is also the continuation fragment. The viewport sentinel replaces
// itself with the next batch, while its href remains conventional navigation.
templ eventRows(sessionID model.SessionID, page app.TimelinePage, refs map[model.EventID]eventReference, csrf string) {
	if len(page.Events) == 0 {
		<p class="empty-state">No normalized events are available.</p>
	} else {
		for _, event := range page.Events {
			<article id={ eventAnchorID(event.ID) } class={ eventCardClass(event, page.FocusedEvent) }>
				<div class="event-marker" aria-hidden="true"></div>
				<div class="event-card">
					@eventMetadata(event)
					if payload, ok := page.Payloads[event.ID]; ok && payload != nil {
						@timelinePayload(event, payload, csrf)
					} else {
						<div class="unavailable-card" role="status">
							<h3>Evidence unavailable</h3>
							<p>The normalized payload for this event is unavailable; its summary is not a substitute for complete content.</p>
						</div>
					}
				</div>
			</article>
		}
		if page.NextCursor != "" {
			<a class="button load-more timeline-sentinel" rel="next" href={ templ.URL(timelinePageURL(sessionID, page.NextCursor)) } hx-get={ timelineFragmentURL(sessionID, page.NextCursor) } hx-trigger="revealed" hx-target="this" hx-swap="outerHTML" hx-indicator="this">
				<span class="load-label">Load more events</span>
				<span class="htmx-indicator">Loading more events…</span>
			</a>
		}
	}
}

templ eventMetadata(event model.EventSummary) {
	<header class="event-heading">
		<span class="event-kind">{ string(event.Kind) }</span>
		<span class="metadata">#{ strconvFormatInt(event.Sequence) } · { formatTime(event.Timestamp) }</span>
	</header>
}

templ timelinePayload(event model.EventSummary, payload model.NormalizedData, csrf string) {
	switch value := payload.(type) {
		case model.MessageData:
			@messageCard(value)
		case model.SummaryData:
			@summaryCard(value)
		case model.ToolCallData:
			@toolCallCard(value)
		case model.ToolResultData:
			@toolResultCard(value)
		case model.CommandData:
			@commandCard(value)
		case model.PatchData:
			@patchCard(value)
		case model.FileReadData:
			@fileReadCard(value)
		case model.FileMutationData:
			@fileMutationCard(value)
		case model.UsageData:
			@usageCard(value)
		case model.ErrorData:
			@errorCard(value)
		case model.UnknownData:
			@unknownCard(event, value, csrf)
		default:
			<div class="unavailable-card" role="status"><h3>Evidence unavailable</h3><p>The normalized payload type cannot be presented.</p></div>
	}
}

templ messageCard(message model.MessageData) {
	<section class={ "message-card message-" + string(message.Role) }>
		<h3>{ messageRoleLabel(message.Role) }</h3>
		<div class="message-text">{ message.Text }</div>
	</section>
}

templ summaryCard(summary model.SummaryData) {
	<details class={ "activity-card summary-card summary-" + string(summary.Category) }>
		<summary>
			<span class="activity-title">{ app.SummaryCategoryTitle(summary.Category) }</span>
			<span class="summary-preview">{ summary.Text }</span>
		</summary>
		<div class="expanded-content">
			<h3>{ app.SummaryCategoryTitle(summary.Category) }</h3>
			<pre>{ summary.Text }</pre>
		</div>
	</details>
}

templ toolCallCard(call model.ToolCallData) {
	<div class="activity-card tool-card">
		<h3>Tool call <span class="chip">requested</span></h3>
		<p><strong>{ call.ToolName }</strong> <span class="metadata">Call { call.CallID }</span></p>
		if formatted, valid := formattedJSON(call.Input); valid {
			<pre class="json-input">{ formatted }</pre>
		}
		<details>
			<summary>Raw tool input</summary>
			<pre>{ call.Input }</pre>
		</details>
	</div>
}

templ toolResultCard(result model.ToolResultData) {
	<div class={ "activity-card tool-card tool-" + toolResultState(result.IsError) }>
		<h3>Tool result <span class="chip">{ toolResultState(result.IsError) }</span></h3>
		<p><strong>{ result.ToolName }</strong> <span class="metadata">Call { result.CallID }</span></p>
		<details>
			<summary>Tool output</summary>
			<pre>{ result.Output }</pre>
		</details>
	</div>
}

templ commandCard(command model.CommandData) {
	<div class={ "activity-card command-card " + commandExitState(command.ExitCode) }>
		<h3>Command <span class="chip">{ commandExitState(command.ExitCode) }</span></h3>
		<code class="command-line">{ command.Command }</code>
		<p class="metadata">
			Working directory:
			if command.WorkingDirectory == "" {
				<span>unreported</span>
			} else {
				<span>{ command.WorkingDirectory }</span>
			}
		</p>
		<details>
			<summary>Command output</summary>
			<pre>{ command.Output }</pre>
		</details>
	</div>
}

templ patchCard(patch model.PatchData) {
	<div class="activity-card patch-card">
		<h3>Changed files</h3>
		<p class="metadata">{ pathSummary(patch.Paths) }</p>
		<details>
			<summary>Patch</summary>
			<pre class="patch">
				for _, line := range patchLines(patch.Text) {
					<span class={ line.Class }>{ line.Text }</span>
				}
			</pre>
		</details>
	</div>
}

templ fileReadCard(read model.FileReadData) {
	<div class="activity-card file-card">
		<h3>Read file</h3>
		<code>{ read.Path }</code>
		<span class="metadata">{ lineRangeLabel(read.StartLine, read.EndLine) }</span>
	</div>
}

templ fileMutationCard(mutation model.FileMutationData) {
	<div class="activity-card file-card">
		<h3>{ string(mutation.Operation) } file</h3>
		<code>{ mutation.Path }</code>
		if mutation.PreviousPath != "" {
			<p class="metadata">Renamed from <code>{ mutation.PreviousPath }</code></p>
		}
	</div>
}

templ usageCard(usage model.UsageData) {
	<div class="activity-card usage-card">
		<h3>Token usage</h3>
		<dl>
			<div><dt>Input</dt><dd>{ tokenCount(usage.InputTokens) }</dd></div>
			<div><dt>Output</dt><dd>{ tokenCount(usage.OutputTokens) }</dd></div>
			<div><dt>Cache read</dt><dd>{ tokenCount(usage.CacheReadTokens) }</dd></div>
			<div><dt>Cache write</dt><dd>{ tokenCount(usage.CacheWriteTokens) }</dd></div>
		</dl>
	</div>
}

templ errorCard(value model.ErrorData) {
	<div class="activity-card error-card" role="alert">
		<h3>
			Error
			if value.Code != "" {
				<span>· { value.Code }</span>
			}
		</h3>
		<pre>{ value.Message }</pre>
	</div>
}

templ unknownCard(event model.EventSummary, value model.UnknownData, csrf string) {
	<div class="activity-card unknown-card">
		<h3>Unknown event</h3>
		<p><strong>Reason:</strong> { string(value.Reason) }</p>
		<p><strong>Original kind:</strong> { value.OriginalKind }</p>
		<form method="post" action={ templ.SafeURL(unknownEvidenceFragmentURL(event.SessionID, event.ID)) } hx-post={ unknownEvidenceFragmentURL(event.SessionID, event.ID) } hx-target="next .unknown-evidence" hx-swap="innerHTML">
			<input type="hidden" name="csrf" value={ csrf }/>
			<button type="submit" class="button quiet">Inspect retained Unknown evidence</button>
		</form>
		<div class="unknown-evidence" aria-live="polite"></div>
	</div>
}

templ unknownEvidence(inspection app.UnknownEvidenceInspection) {
	if inspection.State == app.EvidenceUnavailable {
		<p class="notice warning">Retained evidence is unavailable. This is not evidence of success.</p>
	} else {
		<div class="retained-evidence">
			<h3>Redacted retained evidence</h3>
			<p class="metadata">
				{ strconvFormatInt(inspection.ReturnedSize) } of { strconvFormatInt(inspection.OriginalSize) } bytes · { strconvFormatInt(int64(inspection.RedactionCount)) } redactions
				if inspection.Truncated {
					<span>· truncated</span>
				}
			</p>
			<pre>{ inspection.Text }</pre>
		</div>
	}
}
