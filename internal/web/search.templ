package web

templ searchPage(view searchView) {
	@document("Search · AgentSession") {
		<main id="main" class="page">
			<section class="page-heading">
				<div>
					<p class="eyebrow">Canonical evidence projection</p>
					<h1>Search</h1>
					<p>Find sessions containing matching canonical evidence. Terms are combined with AND.</p>
				</div>
			</section>
			<form class="panel" action="/search" method="get">
				<label for="search-query">Query</label>
				<div class="action-row">
					<input id="search-query" name="q" value={ view.Query } maxlength="4096" autofocus/>
					<button type="submit">Search</button>
				</div>
				<p class="muted"><code>session:</code> <code>kind:</code> <code>after:</code> <code>before:</code> <code>file:</code> <code>tool:</code> <code>command:</code></p>
			</form>
			if view.Err != nil {
				<p class="notice error" role="alert">{ view.Err.Error() }</p>
			} else {
				<p class="notice" role="status">{ availabilityMessage(view.Page.Availability) }</p>
				if len(view.Page.Results) == 0 {
					<section class="empty-state"><h2>No matching sessions</h2></section>
				} else {
					<section class="session-list" aria-label="Search results">
						for _, result := range view.Page.Results {
							<article class="session-card">
								<div class="session-card-heading">
									<h2><a href={ templ.URL(sessionURL(result.SessionID)) }>{ searchSessionTitle(result) }</a></h2>
									<span class="badge">{ result.AgentName }</span>
								</div>
								if result.Preview != "" && result.Preview != searchSessionTitle(result) {
									<p>{ result.Preview }</p>
								}
								<p class="muted">{ formatTime(result.LastActivityAt) } · { formatCount(result.EventCount, "event") } · { formatCount(result.MatchCount, "matching event") }</p>
								<p><strong>{ result.BestMatchSummary }</strong></p>
								<p>{ compactSnippet(result.Snippet) }</p>
							</article>
						}
					</section>
				}
				<nav class="pagination" aria-label="Search result pages">
					if view.Page.PreviousCursor != "" {
						<a href={ templ.SafeURL(searchPageURL(view.Query, view.Page.PreviousCursor)) }>Previous</a>
					}
					if view.Page.NextCursor != "" {
						<a href={ templ.SafeURL(searchPageURL(view.Query, view.Page.NextCursor)) }>Next</a>
					}
				</nav>
			}
		</main>
	}
}
