package web

import (
	"github.com/pooya79/AgentSession/internal/app"
	"github.com/pooya79/AgentSession/internal/model"
)

// sourceText is the mandatory escaped-text boundary for untrusted web content.
templ sourceText(content string) {
	{ content }
}

templ document(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content="{&quot;includeIndicatorStyles&quot;:false}"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/assets/styles.css"/>
			<script src="/assets/htmx.min.js" defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ indexPage() {
	@document("AgentSession") {
		<header class="site-header">
			<a class="brand" href="/">AgentSession <span>Evidence inspector</span></a>
			<span class="privacy-mark">Local · offline · read-only</span>
		</header>
		<main>
			<section class="hero compact">
				<p class="eyebrow">Local evidence workspace</p>
				<h1>Inspect the record, not the claim.</h1>
				<p class="lede">AgentSession indexes supported agent histories automatically and preserves incomplete or contradictory evidence for review.</p>
			</section>
			<div class="dashboard">
				<section class="index-panel" aria-labelledby="index-title">
					<div class="section-heading">
						<div>
							<p class="eyebrow">Index lifecycle</p>
							<h2 id="index-title">All supported sources</h2>
						</div>
					</div>
					<div id="import-status" hx-get="/fragments/import-status" hx-trigger="load" hx-swap="innerHTML">
						<p class="notice" role="status">Reading indexing status…</p>
					</div>
				</section>
				<section aria-labelledby="sessions-title">
					<div class="section-heading">
						<h2 id="sessions-title">Imported sessions</h2>
						<button class="quiet" type="button" hx-get="/fragments/sessions" hx-target="#sessions-panel" hx-swap="innerHTML">Refresh</button>
					</div>
					<div id="sessions-panel" hx-get="/fragments/sessions" hx-trigger="load, sessionsRefresh from:body" hx-swap="innerHTML">
						<p class="muted" role="status">Loading imported sessions…</p>
					</div>
				</section>
			</div>
		</main>
	}
}

templ importStatusFragment(status app.ImportAllStatus) {
	<div class={ "import-overview phase-" + string(status.Phase) } aria-live="polite">
		<div class="status-line">
			<span class="status-dot" aria-hidden="true"></span>
			<div>
				if status.Active {
					<strong>Indexing local evidence</strong>
					<p>Processing { formatCount(status.SourcesDiscovered, "source") }. This continues if you leave the page.</p>
				} else if status.Phase == app.ImportAllUpToDate {
					<strong>Index is up to date</strong>
					if status.SourcesDiscovered == 0 {
						<p>No supported sources were found. Configure a source path or install a supported agent, then rescan.</p>
					} else {
						<p>The latest scan completed without failures or diagnostics.</p>
					}
				} else if status.Phase == app.ImportAllIssues {
					<strong>Indexing completed with issues</strong>
					<p>Available evidence was retained. Review failures and diagnostics before drawing conclusions.</p>
				} else {
					<strong>Indexing unavailable</strong>
					<p>{ status.Failure }</p>
				}
			</div>
			<form method="post" action="/imports" hx-post="/imports" hx-target="#import-status" hx-swap="innerHTML" hx-headers={ `{"X-AgentSession-Request":"import"}` }>
				<button type="submit" disabled?={ status.Active }>
					if status.Active {
						Scanning…
					} else {
						Rescan all sources
					}
				</button>
			</form>
		</div>
		<div class="stat-grid" aria-label="Index statistics">
			<div><strong>{ strconvFormatInt(status.SourcesCompleted) }/{ strconvFormatInt(status.SourcesDiscovered) }</strong><span>sources complete</span></div>
			<div><strong>{ strconvFormatInt(status.RecordsProcessed) }</strong><span>records inspected</span></div>
			<div><strong>{ strconvFormatInt(status.EventsProcessed) }</strong><span>events normalized</span></div>
			<div><strong>{ strconvFormatInt(status.SessionsObserved) }</strong><span>sessions observed</span></div>
			<div><strong>{ strconvFormatInt(status.UnchangedSessions) }</strong><span>unchanged</span></div>
			<div><strong>{ strconvFormatInt(status.DiagnosticsTotal) }</strong><span>diagnostics</span></div>
		</div>
		if status.Active {
			<div hx-get="/fragments/import-status" hx-trigger="load delay:500ms" hx-target="#import-status" hx-swap="innerHTML"></div>
		}
		if len(status.RecentDiagnostics) > 0 {
			<details class="diagnostics" open>
				<summary>Recent diagnostics ({ strconvFormatInt(status.DiagnosticsTotal) })</summary>
				<ul>
					for _, diagnostic := range status.RecentDiagnostics {
						<li>
							<strong><span class={ "severity severity-" + string(diagnostic.Severity) }>{ string(diagnostic.Severity) }</span> { diagnostic.Code }</strong>
							<span>{ diagnostic.Message }</span>
							if diagnostic.SourceID != "" {
								<code>source { string(diagnostic.SourceID) }</code>
							}
							if diagnostic.SourcePath != "" {
								<code>{ diagnostic.SourcePath }</code>
							}
							@evidenceChips(diagnostic.EventIDs, diagnostic.RawRecordIDs)
						</li>
					}
				</ul>
				if status.DiagnosticsOmitted > 0 {
					<p class="muted">{ formatCount(status.DiagnosticsOmitted, "earlier diagnostic") } omitted from this bounded status.</p>
				}
			</details>
		}
		if len(status.Sources) > 0 {
			<details class="source-drawer">
				<summary>Source details</summary>
				<div class="source-list">
					for _, source := range status.Sources {
						<div class="source-row">
							<div class="source-copy">
								<strong>{ source.Kind }</strong>
								<code>{ source.Path }</code>
								<small>{ source.Origin }</small>
							</div>
							<div class="source-state">
								<span>{ string(source.Phase) }</span>
								<small>{ formatCount(source.Records, "record") } · { formatCount(source.Events, "event") }</small>
								if source.Failure != "" {
									<em>{ source.Failure }</em>
								}
							</div>
						</div>
					}
				</div>
			</details>
		}
	</div>
}

templ sourcesFragment(discovery app.SourceDiscovery) {
	<div class={ "fragment-state state-" + string(discovery.State) }>
		if discovery.State == app.EvidenceUnavailable {
			<p class="notice warning" role="status">Source discovery is unavailable. Review the diagnostics below.</p>
		} else if len(discovery.Sources) == 0 {
			<p class="notice" role="status">No supported session sources were found.</p>
		} else {
			<p>{ formatCount(int64(len(discovery.Sources)), "source") } discovered.</p>
		}
		if len(discovery.Diagnostics) > 0 {
			<div class="diagnostics" aria-label="Discovery diagnostics">
				<h3>Discovery diagnostics</h3>
				<ul>
					for _, diagnostic := range discovery.Diagnostics {
						<li>
							<strong>{ string(diagnostic.Severity) }: { diagnostic.Code }</strong>
							<span>{ diagnostic.Message }</span>
							if diagnostic.Path != "" {
								<code>{ diagnostic.Path }</code>
							}
						</li>
					}
				</ul>
			</div>
		}
	</div>
}

templ sessionsFragment(page app.SessionPage, first bool) {
	if first && len(page.Sessions) == 0 {
		<p class="notice" role="status">No indexed sessions are available yet. Indexing status above will show whether sources are still being processed or unavailable.</p>
	} else {
		<div class="session-list">
			for _, session := range page.Sessions {
				<a class={ "session-card state-" + string(session.State) } href={ templ.URL(timelineURL(session.ID)) }>
					<span class="card-top">
						<span class="session-title">{ sessionTitle(session) }</span>
						<span class={ "badge state-" + string(session.State) }>{ string(session.State) }</span>
						if session.Diagnostics.Total > 0 {
							<span class="badge diagnostic">{ formatCount(session.Diagnostics.Total, "diagnostic") }</span>
						}
					</span>
					if session.Summary != "" {
						<span class="session-summary">{ session.Summary }</span>
					}
					<span class="metadata">
						{ formatTime(session.StartedAt) } · { formatCount(session.EventCount, "event") } · { string(session.State) }
					</span>
				</a>
			}
		</div>
		if page.NextCursor != "" {
			<button class="load-more" hx-get={ sessionsFragmentURL(page.NextCursor) } hx-target="this" hx-swap="outerHTML">Load more sessions</button>
		}
	}
}

templ timelinePage(sessionID model.SessionID, page app.TimelinePage) {
	@document("Timeline · AgentSession") {
		<header class="site-header">
			<a class="brand" href="/">AgentSession <span>Evidence inspector</span></a>
			<a class="back-link" href="/">← All sessions</a>
		</header>
		<main>
			<section class="timeline-heading">
				<p class="eyebrow">Session timeline</p>
				<h1 class="session-id">{ string(sessionID) }</h1>
				<p class="muted">Normalized summaries load first. Payloads remain collapsed until requested.</p>
			</section>
			<section aria-label="Session events">
				@timelineEvidenceState(page)
				<div class="timeline">
					@timelineFragment(sessionID, page)
				</div>
			</section>
		</main>
	}
}

templ timelineEvidenceState(page app.TimelinePage) {
	if page.State == app.EvidenceUnavailable {
		<p class="notice warning">Timeline evidence is unavailable. Diagnostics were retained, but no normalized events are available.</p>
	} else if page.State == app.EvidencePartial {
		<p class="notice warning">This timeline contains partial evidence. Review the diagnostics before drawing conclusions.</p>
	}
	@diagnosticSynopsis(page.Diagnostics)
}

templ timelineFragment(sessionID model.SessionID, page app.TimelinePage) {
	if len(page.Events) == 0 && page.NextCursor == "" {
		<p class="notice">No normalized events are available for this session.</p>
	} else {
		for _, event := range page.Events {
			<article id={ eventAnchorID(event.ID) } class="event" data-kind={ string(event.Kind) }>
				<div class="event-marker" aria-hidden="true"></div>
				<div class="event-card">
					<div class="event-heading">
						<span class="event-kind">{ string(event.Kind) }</span>
						<span class="metadata">#{ strconvFormatInt(event.Sequence) } · { formatTime(event.Timestamp) }</span>
					</div>
					<p>{ event.Summary }</p>
					<button class="quiet" type="button" hx-get={ eventFragmentURL(sessionID, event.ID) } hx-target="next .event-detail" hx-swap="innerHTML">Inspect event detail</button>
					<div class="event-detail" aria-live="polite"></div>
				</div>
			</article>
		}
		if page.NextCursor != "" {
			<button class="load-more" hx-get={ timelineFragmentURL(sessionID, page.NextCursor) } hx-target="this" hx-swap="outerHTML">Load more events</button>
		}
	}
}

templ eventFragment(detail app.EventDetail, payload string) {
	<div class={ "detail-panel state-" + string(detail.State) }>
		if detail.State == app.EvidenceUnavailable || detail.Payload == nil {
			<p class="notice warning">The normalized payload is unavailable. This is not evidence of success.</p>
		} else {
			<h3>Normalized payload</h3>
			<pre>{ payload }</pre>
		}
		@diagnosticSynopsis(detail.Diagnostics)
	</div>
}

templ diagnosticSynopsis(synopsis app.DiagnosticSynopsis) {
	if synopsis.Total > 0 {
		<details class="diagnostics">
			<summary>{ formatCount(synopsis.Total, "diagnostic") } retained with this evidence</summary>
			<ul>
				for _, diagnostic := range synopsis.Diagnostics {
					@diagnosticItem(diagnostic)
				}
			</ul>
			if synopsis.Omitted > 0 {
				<p class="muted">{ formatCount(synopsis.Omitted, "additional diagnostic") } omitted.</p>
			}
		</details>
	}
}

templ diagnosticItem(diagnostic model.Diagnostic) {
	<li>
		<strong>{ string(diagnostic.Severity) }: { diagnostic.Code }</strong>
		<span>{ diagnostic.Message }</span>
		@evidenceChips(diagnostic.EventIDs, diagnostic.RawRecordIDs)
	</li>
}

templ evidenceChips(eventIDs []model.EventID, rawRecordIDs []model.RawRecordID) {
	if len(eventIDs) > 0 || len(rawRecordIDs) > 0 {
		<div class="evidence-chips" aria-label="Diagnostic evidence references">
			for _, eventID := range eventIDs {
				<a class="chip" href={ templ.SafeURL(eventAnchorURL(eventID)) }>event { string(eventID) }</a>
			}
			for _, recordID := range rawRecordIDs {
				<span class="chip raw">record { string(recordID) }</span>
			}
		</div>
	}
}
